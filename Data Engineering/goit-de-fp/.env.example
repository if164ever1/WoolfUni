# Source account is read-only. Change course host and keep your real values out of git.
SOURCE_JDBC_URL='jdbc:mysql://127.0.0.1:3306/olympic_dataset'
SOURCE_MYSQL_USER='your_read_user'
SOURCE_MYSQL_PASSWORD='replace_locally'

# Sink schema must already exist. Use a user with CREATE and write privileges.
SINK_MYSQL_HOST='127.0.0.1'
SINK_MYSQL_PORT='3306'
SINK_MYSQL_DATABASE='olympic_dataset'
SINK_MYSQL_USER='your_write_user'
SINK_MYSQL_PASSWORD='replace_locally'
SINK_MYSQL_TABLE='athlete_avg_stats'

KAFKA_BOOTSTRAP_SERVERS='127.0.0.1:9092'
KAFKA_INPUT_TOPIC='athlete_event_results'
KAFKA_OUTPUT_TOPIC='athlete_avg_stats'
# Optional protected JSON path for connector options, e.g. kafka.security.protocol.
# SPARK_KAFKA_OPTIONS_FILE='/private/path/kafka-options.json'
CHECKPOINT_DIR='./checkpoints/athlete_avg_stats'
SPARK_SHUFFLE_PARTITIONS='4'
